<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">
    <changeSet id="010-remove-dormitory-id-from-users" author="Julia Khval">
    <preConditions onFail="MARK_RAN">
        <columnExists tableName="users" columnName="dormitory_id"/>
    </preConditions>
    <dropForeignKeyConstraint baseTableName="users" constraintName="fk_users_dormitory"/>
    <dropColumn tableName="users" columnName="dormitory_id"/>
</changeSet>
</databaseChangeLog>