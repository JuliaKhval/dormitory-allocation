<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">
<changeSet id="007-create-allocations-table" author="Julia Khval">
<createTable tableName="allocations">
    <column name="id" type="BIGINT" autoIncrement="true">
        <constraints primaryKey="true" nullable="false"/>
    </column>
    <column name="request_id" type="BIGINT">
        <constraints nullable="false" unique="true" foreignKeyName="fk_allocations_request" references="requests(id)"/>
    </column>
    <column name="room_id" type="BIGINT">
        <constraints nullable="false" foreignKeyName="fk_allocations_room" references="rooms(id)"/>
    </column>
    <column name="allocated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
        <constraints nullable="false"/>
    </column>
</createTable>
</changeSet>
        </databaseChangeLog>