<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.17.xsd">
<changeSet id="006-create-request-preferred-roommates-table" author="Julia Khval">
<createTable tableName="request_preferred_roommates">
    <column name="request_id" type="BIGINT">
        <constraints nullable="false" foreignKeyName="fk_pref_request" references="requests(id)"/>
    </column>
    <column name="preferred_student_id" type="BIGINT">
        <constraints nullable="false" foreignKeyName="fk_pref_student" references="students(id)"/>
    </column>
</createTable>

<addPrimaryKey tableName="request_preferred_roommates"
               columnNames="request_id, preferred_student_id"
               constraintName="pk_request_preferred_roommates"/>
</changeSet>
        </databaseChangeLog>